  "pronunciation_notes": [
    {
      "title": "General rule",
      "note": "Afrikaans is largely pronounced as spelled, using the same alphabet as English."
    },
    {
      "title": "g",
      "note": "Guttural, like Scottish 'loch' / clearing throat. Example: goed (good), gaan (go)."
    },
    {
      "title": "r",
      "note": "Rolled/trilled, unlike English. Example: rooi, môre."
    },
    {
      "title": "w = v, v = f, j = y",
      "note": "w sounds like English v (water = VAH-ter), v sounds like f (vier = fear), j sounds like y (ja = ya, jammer = YAH-mer)."
    },
    {
      "title": "ie vs ei",
      "note": "ie = long ee as in 'breed' (sien = seen). ei = like 'sale' (lei, klein = klayn)."
    },
    {
      "title": "oe",
      "note": "Like oo in 'loot' (boek = book, goed). ou = like 'coat' (oud, vrou = frow)."
    },
    {
      "title": "ui",
      "note": "No English equivalent; round lips, say between 'play' and 'house'. Example: huis (hays), uit, tuin."
    },
    {
      "title": "ô / ê",
      "note": "Circumflex changes sound: môre (morning), ê like 'apple'. Days/months lowercase: maandag, januarie."
    }
  ],
  "grammar_notes": [
    {
      "title": "Double negative nie...nie",
      "note": "Negation wraps the clause: nie after verb/object + nie at very end. Example: Ek praat nie Afrikaans nie (I don't speak Afrikaans). Short clauses ending in verb use one nie: Ek weet nie (I don't know)."
    },
    {
      "title": "No verb conjugation",
      "note": "Verbs don't change by subject: ek is, jy is, hy is, ons is (I am, you are, he is, we are). Same for het, gaan, kom, etc."
    },
    {
      "title": "Past tense with het + ge-",
      "note": "Past = het + verb with ge- prefix. Example: Ek het geëet (I ate / have eaten), Ek het gesien (I saw)."
    },
    {
      "title": "Future with sal",
      "note": "Future = sal + infinitive. Example: Ek sal gaan (I will go), Hy sal vlieg (He will fly)."
    },
    {
      "title": "Basic word order SVO, V2 rule",
      "note": "Basic: Ek drink water (I drink water). If sentence starts with time/place, verb stays second: Gister het ek... (Yesterday I...), not Gister ek het."
    },
    {
      "title": "Formal you: u vs jy",
      "note": "jy/jou = informal you/your. u = formal/respectful (older people, teachers, clients). Hoe gaan dit met jou? vs Hoe gaan dit met u?"
    },
    {
      "title": "Indefinite article 'n",
      "note": "'n = a/an, never capitalized even at sentence start. Example: Ek is 'n beginner (I am a beginner), 'n boek (a book)."
    },
    {
      "title": "Diminutive -tjie / -jie",
      "note": "Add -tjie/-jie for 'little': koppie (cup, from kop), tafeltjie (small table). Pronounced -kie. Very common in daily speech."
    }
  ]
}