 {
  "id": "s:Hallo! Hoe gaan dit met jou?",
  "text": "Hallo! Hoe gaan dit met jou?"
 },
 {
  "id": "s:Dit gaan goed, dankie. En jy?",
  "text": "Dit gaan goed, dankie. En jy?"
 },
 {
  "id": "s:My naam is Jan.",
  "text": "My naam is Jan."
 },
 {
  "id": "s:Wat is jou naam?",
  "text": "Wat is jou naam?"
 },
 {
  "id": "s:Waar is jy vandaan?",
  "text": "Waar is jy vandaan?"
 },
 {
  "id": "s:Ek woon in Suid-Afrika.",
  "text": "Ek woon in Suid-Afrika."
 },
 {
  "id": "s:Aangename kennis.",
  "text": "Aangename kennis."
 },
 {
  "id": "s:Praat jy Engels?",
  "text": "Praat jy Engels?"
 },
 {
  "id": "s:Ek praat net 'n bietjie Afrikaans.",
  "text": "Ek praat net 'n bietjie Afrikaans."
 },
 {
  "id": "s:Ek verstaan nie.",
  "text": "Ek verstaan nie."
 },
 {
  "id": "s:Kan jy stadig praat, asseblief?",
  "text": "Kan jy stadig praat, asseblief?"
 },
 {
  "id": "s:Hoeveel kos dit?",
  "text": "Hoeveel kos dit?"
 },
 {
  "id": "s:Ek wil dit graag hê.",
  "text": "Ek wil dit graag hê."
 },
 {
  "id": "s:Mag ek die spyskaart sien, asseblief?",
  "text": "Mag ek die spyskaart sien, asseblief?"
 },
 {
  "id": "s:Die rekening, asseblief.",
  "text": "Die rekening, asseblief."
 },
 {
  "id": "s:Dit was heerlik.",
  "text": "Dit was heerlik."
 },
 {
  "id": "s:Waar is die toilet?",
  "text": "Waar is die toilet?"
 },
 {
  "id": "s:Waar is die treinstasie?",
  "text": "Waar is die treinstasie?"
 },
 {
  "id": "s:Hoe kom ek daar?",
  "text": "Hoe kom ek daar?"
 },
 {
  "id": "s:Draai links.",
  "text": "Draai links."
 },
 {
  "id": "s:Draai regs.",
  "text": "Draai regs."
 },
 {
  "id": "s:Ek is verdwaald.",
  "text": "Ek is verdwaald."
 },
 {
  "id": "s:Ek het hulp nodig.",
  "text": "Ek het hulp nodig."
 },
 {
  "id": "s:Ek eet 'n appel.",
  "text": "Ek eet 'n appel."
 },
 {
  "id": "s:Ek drink koffie.",
  "text": "Ek drink koffie."
 },
 {
  "id": "s:Goeie môre! Het jy goed geslaap?",
  "text": "Goeie môre! Het jy goed geslaap?"
 },
 {
  "id": "s:Hoe gaan dit met die familie?",
  "text": "Hoe gaan dit met die familie?"
 },
 {
  "id": "s:Lanklaas gesien!",
  "text": "Lanklaas gesien!"
 },
 {
  "id": "s:Wat maak jy vandag?",
  "text": "Wat maak jy vandag?"
 },
 {
  "id": "s:Kom ons gaan koffie drink.",
  "text": "Kom ons gaan koffie drink."
 },
 {
  "id": "s:Jy lyk goed vandag.",
  "text": "Jy lyk goed vandag."
 },
 {
  "id": "s:Hoe was jou naweek?",
  "text": "Hoe was jou naweek?"
 },
